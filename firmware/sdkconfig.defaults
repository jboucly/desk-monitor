# Desk Monitor — ESP-IDF defaults for the Guition ESP32-S3-4848S040 (16 MB flash, 8 MB octal PSRAM).
# The generated sdkconfig is not versioned: delete it after editing this file.

# Chip, flash and partitions (2 OTA slots + LittleFS for layout.json / settings.json)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU and caches
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# PSRAM: frame buffer, wallpaper, JSON trees. Code and rodata run from PSRAM so that
# flash writes (OTA, LittleFS) do not starve the RGB panel (same as ESPHome's execute_from_psram)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# RGB panel
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# Network
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y
CONFIG_LWIP_LOCAL_HOSTNAME="desk-monitor"
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
# PC companion link (ws://<screen>/api/pc)
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Bluetooth arrives in phase 2 (PC companion)
CONFIG_BT_ENABLED=n

# LVGL 9 (mirrors firmware/sim/lv_conf.h)
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL heap in PSRAM: allocator in main/psram_alloc.cpp
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
# Not CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM: it moves ~107 KB of LVGL into IRAM, which is carved out of
# internal RAM, and Wi-Fi + the HTTP server then ran out of it. Code runs from PSRAM through the cache.
CONFIG_LV_CACHE_DEF_SIZE=0
# JPEG decoder for Home Assistant covers (used directly by core/src/cover.cpp)
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
