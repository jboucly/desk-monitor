firmware/dependencies.lock

# Simulator build (also holds its layout.json / settings.json)
firmware/sim/build/

# Web editor
web/node_modules/
web/dist/

# Companion (Rust / Tauri)
companion/node_modules/
companion/src-tauri/target/
companion/src-tauri/gen/

# Built by companion/src-tauri/build.rs
companion/src-tauri/resources/

# Local leftovers of the removed v1 (ESPHome secrets, caches)
legacy/
